          <damping>0.05</damping>
        </dynamics>
      </axis>
    </joint>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>support_blade_joint</joint_name>
      <topic>/cargo_robot/support_blade_joint/cmd</topic>
      <use_velocity_commands>true</use_velocity_commands>
      <cmd_max>0.18</cmd_max>
    </plugin>
    <joint name="nose_belt_joint" type="revolute">
      <pose relative_to="nose_belt_roller_link">0 0 0 0 0 0</pose>
      <parent>support_blade_link</parent>
      <child>nose_belt_roller_link</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
          <effort>5.2</effort>
          <velocity>40</velocity>
        </limit>
        <dynamics>
          <damping>0.05</damping>
        </dynamics>
      </axis>
    </joint>
    <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
      <joint_name>nose_belt_joint</joint_name>
      <topic>/cargo_robot/nose_belt_joint/cmd</topic>
    </plugin>
    <joint name="jaw_lift_joint" type="prismatic">
      <pose relative_to="jaw_frame_link">0 0 0 0 0 0</pose>
      <parent>pickup_head_link</parent>
      <child>jaw_frame_link</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>0</lower>
          <upper>0.035</upper>
          <effort>1200</effort>
          <velocity>0.04</velocity>
        </limit>
        <dynamics>
          <damping>0.05</damping>
        </dynamics>
      </axis>
    </joint>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>jaw_lift_joint</joint_name>
      <topic>/cargo_robot/jaw_lift_joint/cmd</topic>
      <use_velocity_commands>true</use_velocity_commands>
      <cmd_max>0.04</cmd_max>
    </plugin>
    <joint name="left_jaw_joint" type="prismatic">
      <pose relative_to="left_jaw_link">0 0 0 0 0 0</pose>
      <parent>jaw_frame_link</parent>
      <child>left_jaw_link</child>
      <axis>
        <xyz>0 -1 0</xyz>
        <limit>
          <lower>0</lower>
          <upper>0.22</upper>
          <effort>450</effort>
          <velocity>0.08</velocity>
        </limit>
        <dynamics>
          <damping>0.05</damping>
        </dynamics>
      </axis>
    </joint>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>left_jaw_joint</joint_name>
      <topic>/cargo_robot/left_jaw_joint/cmd</topic>
      <use_velocity_commands>true</use_velocity_commands>
      <cmd_max>0.08</cmd_max>
    </plugin>
    <joint name="right_jaw_joint" type="prismatic">
      <pose relative_to="right_jaw_link">0 0 0 0 0 0</pose>
      <parent>jaw_frame_link</parent>
      <child>right_jaw_link</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>0</lower>
          <upper>0.22</upper>
          <effort>450</effort>
          <velocity>0.08</velocity>
        </limit>
        <dynamics>
          <damping>0.05</damping>
        </dynamics>
      </axis>
    </joint>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>right_jaw_joint</joint_name>
      <topic>/cargo_robot/right_jaw_joint/cmd</topic>
      <use_velocity_commands>true</use_velocity_commands>
      <cmd_max>0.08</cmd_max>
    </plugin>
    <plugin filename="gz-sim-mecanum-drive-system" name="gz::sim::systems::MecanumDrive">
      <front_left_joint>fl_wheel_joint</front_left_joint>
      <front_right_joint>fr_wheel_joint</front_right_joint>
      <back_left_joint>rl_wheel_joint</back_left_joint>
      <back_right_joint>rr_wheel_joint</back_right_joint>
      <wheelbase>0.72</wheelbase>
      <wheel_separation>0.58</wheel_separation>
      <wheel_radius>0.075</wheel_radius>
      <topic>/cargo_robot/cmd_vel</topic>
      <odom_topic>/cargo_robot/odom</odom_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <max_linear_velocity>0.3</max_linear_velocity>
      <min_linear_velocity>-0.3</min_linear_velocity>
      <max_linear_acceleration>0.25</max_linear_acceleration>
      <min_linear_acceleration>-0.25</min_linear_acceleration>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/cargo_robot/joint_states</topic>
    </plugin>
    <plugin filename="libCargoHandling.so" name="cargo::CargoHandling" />
  </model>
</sdf>